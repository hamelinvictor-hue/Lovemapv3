rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleData) {
      return isSignedIn() && (request.auth.uid in coupleData.memberUids);
    }

    // Collection des couples (ID document = aléatoire)
    match /couples/{coupleId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.memberUids);
      allow update: if isSignedIn() && (
        (request.auth.uid in resource.data.memberUids) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'status', 'updatedAt']) &&
         request.auth.uid in request.resource.data.memberUids)
      );
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.memberUids);

      // Sous-collections spots et notifications
      match /spots/{spotId} {
        allow read, write: if isSignedIn();
      }

      match /notifications/{notifId} {
        allow read, write: if isSignedIn();
      }
    }

    // Collection des codes d'invitation (séparée, consommable)
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.creatorUid == request.auth.uid
      );
      allow update, delete: if isSignedIn();
    }

    // Utilisateurs et profil individuel
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Collection sécurisée pour les secrets serveurs (Apple refresh tokens, etc.)
    // Strictement inaccessible depuis les clients authentifiés - Admin SDK uniquement
    match /private/{userId} {
      allow read, write: if false;
    }
  }
}
