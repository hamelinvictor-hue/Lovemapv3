rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Collection des couples et synchronisation Duo
    match /couples/{coupleId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();

      // Sous-collection des spots intimes
      match /spots/{spotId} {
        allow read, write: if true;
      }

      // Sous-collection des notifications en temps réel
      match /notifications/{notifId} {
        allow read, write: if true;
      }
    }

    // Collection des codes d'invitation consommables
    match /inviteCodes/{code} {
      allow read, write: if true;
    }

    // Utilisateurs et profils individuels
    match /users/{userId} {
      allow read, write: if true;
    }

    // Collection de test / connectivité
    match /test/{docId} {
      allow read, write: if true;
    }

    // Collection sécurisée pour les secrets serveurs (Admin SDK uniquement)
    match /private/{userId} {
      allow read, write: if false;
    }
  }
}
